{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^db:generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {},
    "dev": {
      "dependsOn": [
        "^dev",
        "^db:generate"
      ],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "JWT_SECRET"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL"
      ]
    }
  }
}